[Unit]
Description=Launchee
Requires=jdvm-dbus-session@${image.user.uid}.service
After=jdvm-dbus-session@${image.user.uid}.service

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
User=${image.user}
WorkingDirectory=/home/${image.user}
ExecStart=/usr/local/bin/jdvm-launcher
Restart=always
RestartSec=3s
KillMode=process
