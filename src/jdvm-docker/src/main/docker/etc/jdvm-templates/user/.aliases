# THIS FILE IS MANAGED BY THE CONTAINER AND REPLACED ON STARTUP.
# DO NOT EDIT THIS FILE - ANY CHANGES WILL BE LOST.
# TO ADD YOUR OWN CONFIGURATION, USE: *.local FILE.

# JDVM
alias clear="tput reset"
alias wget="wget --hsts-file ~/.cache/wget-hsts"

# JS
alias bun="NPQ_PKG_MGR=bun NPQ_DISABLE_AUTO_CONTINUE=true npq-hero"
alias npm="NPQ_DISABLE_AUTO_CONTINUE=true npq-hero"
alias pnpm="NPQ_PKG_MGR=pnpm NPQ_DISABLE_AUTO_CONTINUE=true npq-hero"
alias yarn="NPQ_PKG_MGR=yarn NPQ_DISABLE_AUTO_CONTINUE=true npq-hero"

# GO
alias upgrade-delve="go install github.com/go-delve/delve/cmd/dlv@latest"
alias upgrade-wails="go install github.com/wailsapp/wails/v2/cmd/wails@latest"
alias upgrade-garble="go install mvdan.cc/garble@latest"

# DOCKER
alias d="docker"
complete -F __start_docker d

# KUBERNETES
alias kcl="k3d cluster list"
