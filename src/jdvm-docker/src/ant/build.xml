<project name="jdvm-docker">
    <target name="set-git-revision-property">
        <exec executable="git" outputproperty="git.revision" failifexecutionfails="false">
            <arg value="rev-parse"/>
            <arg value="HEAD"/>
        </exec>
        <condition property="git.revision" value="${git.revision}">
            <isset property="git.revision"/>
        </condition>
        <condition property="git.revision" value="unknown">
            <not>
                <isset property="git.revision"/>
            </not>
        </condition>
        <echo>Git Revision: ${git.revision}</echo>
        <echo file="${project.build.directory}/project-properties/git.properties" message="git.revision=${git.revision}"/>
    </target>
    <target name="use-builder">
        <exec executable="docker" resultproperty="builder.used">
            <arg value="buildx"/>
            <arg value="use"/>
            <arg value="${builder.name}"/>
        </exec>
        <condition property="skip.create-builder" else="false">
            <equals arg1="${builder.used}" arg2="0"/>
        </condition>
        <echo>${builder.name} used: ${skip.create-builder}</echo>
        <echo file="${project.build.directory}/project-properties/builder.properties" message="skip.create-builder=${skip.create-builder}"/>
    </target>
</project>
